# =============================================================================
# KubeWatch Backend Environment Configuration
# =============================================================================
# Copy this file to .env in the backend directory to customize your local setup.

APP_ENV=development

# Kubernetes Connection Mode: 'local' (uses ~/.kube/config) or 'in_cluster'
KUBERNETES_MODE=local

# Optional: Specific kubeconfig context to use (leave empty for current-context)
KUBE_CONTEXT=

# Prometheus HTTP API base URL (accessible locally via kubectl port-forward)
PROMETHEUS_URL=http://localhost:9090

# Prometheus HTTP request timeout in seconds
PROMETHEUS_TIMEOUT_SECONDS=10.0

# Database Persistence: PostgreSQL via psycopg 3 driver
# Load from environment, never hardcode passwords in application code
DATABASE_URL=postgresql+psycopg://kubewatch:local_dev_only_change_me@127.0.0.1:5432/kubewatch

# Allowed CORS origins for the frontend (JSON array string or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174"]

# Polling and query constraints
POLL_INTERVAL_SECONDS=60
MAX_QUERY_RANGE_HOURS=168
METRICS_STEP_SECONDS=60

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
